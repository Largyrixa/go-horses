# ---- Backend (FastAPI + Prisma + Postgres) ----
# Banco local via docker-compose (recomendado): postgresql://gohorses:gohorses@localhost:5432/gohorses
# Postgres instalado na VM: ajuste usuário/senha/porta conforme o seu ambiente.
DATABASE_URL="postgresql://gohorses:gohorses@localhost:5432/gohorses?schema=public"

# Segredo para assinar URLs de upload. Troque em produção.
SECRET_KEY="troque-este-segredo-em-producao"

# Origens liberadas no CORS (separadas por vírgula). Em dev, o Vite usa proxy.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# URL pública do backend, usada para montar as URLs das fotos enviadas.
# Em produção na VM (porta 8028 -> 8080 no navegador):
# PUBLIC_BASE_URL="http://200.18.99.113:8028"
PUBLIC_BASE_URL="http://localhost:8000"

# Onde os uploads locais são gravados quando não há storage em nuvem configurado.
UPLOAD_DIR="./uploads"
UPLOAD_MAX_BYTES="5242880"

# Tempo de vida da sessão (dias). RF02: a sessão expira.
SESSION_TTL_DAYS="7"

# Bônus RF32: se "true", exige crédito disponível para dar lance.
# Deixe "false" para a demo do Núcleo funcionar sem renda declarada.
ENFORCE_CREDIT="false"

# Intervalo do processo que abre/fecha leilões automaticamente (segundos).
SYNC_INTERVAL_SECONDS="0.5"

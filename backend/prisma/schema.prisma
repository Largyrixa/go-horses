// Schema do backend Go Horses (leilão online).
// Dinheiro sempre em centavos inteiros; datas em UTC (timestamptz).
// Rodar: npx prisma generate  (ou .venv/bin/prisma generate)
// Aplicar no banco: npx prisma db push

generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuctionStatus {
  scheduled
  running
  sold
  unsold
  cancelled
}

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  password_hash        String
  display_name         String
  monthly_income_cents Int      @default(0)
  created_at           DateTime @default(now()) @db.Timestamptz(3)
  updated_at           DateTime @updatedAt @db.Timestamptz(3)

  sessions Session[]
  items    Item[]
  auctions Auction[] @relation("seller_auctions")
  bids     Bid[]
  leading  Auction[] @relation("auction_leader")
  won      Auction[] @relation("auction_winner")

  @@index([display_name])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid())
  token_hash String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  created_at DateTime @default(now()) @db.Timestamptz(3)
  expires_at DateTime @db.Timestamptz(3)

  @@index([user_id])
  @@index([expires_at])
  @@map("sessions")
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String
  category    String
  photos      String[]
  seller_id   String
  seller      User     @relation(fields: [seller_id], references: [id], onDelete: Cascade)
  created_at  DateTime @default(now()) @db.Timestamptz(3)

  auctions Auction[]

  @@index([seller_id])
  @@index([category])
  @@map("items")
}

model Auction {
  id                  String        @id @default(uuid())
  item_id             String
  item                Item          @relation(fields: [item_id], references: [id], onDelete: Cascade)
  seller_id           String
  seller              User          @relation("seller_auctions", fields: [seller_id], references: [id], onDelete: Cascade)
  status              AuctionStatus @default(scheduled)
  starting_price_cents Int
  current_price_cents Int
  bid_count           Int           @default(0)
  starts_at           DateTime      @db.Timestamptz(3)
  ends_at             DateTime      @db.Timestamptz(3)
  original_ends_at    DateTime      @db.Timestamptz(3)
  extension_seconds   Int           @default(0)
  leader_id           String?
  leader              User?         @relation("auction_leader", fields: [leader_id], references: [id], onDelete: SetNull)
  winner_id           String?
  winner              User?         @relation("auction_winner", fields: [winner_id], references: [id], onDelete: SetNull)
  final_price_cents   Int?
  cancelled_at        DateTime?     @db.Timestamptz(3)
  closed_at           DateTime?     @db.Timestamptz(3)
  created_at          DateTime      @default(now()) @db.Timestamptz(3)
  updated_at          DateTime      @updatedAt @db.Timestamptz(3)

  bids Bid[]

  @@index([status, starts_at])
  @@index([status, ends_at])
  @@index([seller_id])
  @@index([leader_id])
  @@map("auctions")
}

model Bid {
  id              String   @id @default(uuid())
  auction_id      String
  auction         Auction  @relation(fields: [auction_id], references: [id], onDelete: Cascade)
  bidder_id       String
  bidder          User     @relation(fields: [bidder_id], references: [id], onDelete: Cascade)
  amount_cents    Int
  idempotency_key String
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  @@unique([auction_id, idempotency_key])
  @@index([auction_id, created_at])
  @@index([bidder_id, created_at])
  @@map("bids")
}

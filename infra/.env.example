# Copie para .env na VM (cp .env.example .env) e preencha. O .env NUNCA vai para o Git.

# Senha do usuário da aplicação no MySQL.
# Use só letras e números: ela entra numa URL de conexão e símbolos como @ ou / quebram.
DB_PASSWORD=troque-esta-senha

# A senha do root do MySQL é gerada automaticamente no primeiro boot do contêiner
# (não precisa configurar nada aqui).

# Só necessário em desenvolvimento local, quando o front roda no Vite (5173).
# Na VM, front e API compartilham a origem (http://IP:8088), então o CORS não entra em jogo.
CORS_ORIGINS=http://localhost:5173

# Armazenamento de fotos fornecido pela organização (RF07). Preencha com o que eles passarem.
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Limites fáceis de alterar para a demo (RF06). Exemplo: abrir em 1 min, durar 3 min.
LEILAO_ANTECEDENCIA_MIN_SEGUNDOS=60
LEILAO_DURACAO_MIN_SEGUNDOS=180
SESSAO_DURACAO_MINUTOS=60

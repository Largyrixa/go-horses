# Configuração do frontend (Vite)
#
# Em desenvolvimento, deixe VITE_API_URL vazio: o Vite faz proxy de /api
# (REST + WebSocket) para VITE_PROXY_TARGET. O backend roda em :8000.
VITE_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8000

# Em produção na VM, deixe VITE_API_URL vazio também: o Caddy serve o front
# na porta 8080 e faz proxy de /api, /uploads e /static para o backend.
# Só preencha VITE_API_URL se a API estiver em OUTRA origem (sem barra final).
#
# VITE_API_URL=http://200.18.99.113:8028
#
# VITE_WS_URL vazio = usa a mesma origem da API, trocando http por ws.
VITE_WS_URL=

# Limites de fotos (o backend valida de novo, com os mesmos valores).
VITE_MIN_PHOTOS=3
VITE_MAX_PHOTOS=10
VITE_MAX_PHOTO_MB=5

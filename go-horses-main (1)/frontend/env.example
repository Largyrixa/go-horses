# Configuração do frontend (Vite)
#
# Deixe VITE_API_URL vazio: o front chama /api na mesma origem. Em dev quem
# repassa é o proxy do Vite (para VITE_PROXY_TARGET); em produção é o Caddy.
# Assim não há CORS nem URL fixa no bundle, e o mesmo build serve local e VM.
VITE_API_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8088

# O proxy de dev cobre /api (REST + WebSocket), /uploads e /static, que são os
# mesmos caminhos encaminhados pelo Caddy em produção. Não é preciso configurar
# mais nada para as fotos aparecerem em `npm run dev`.
# O site é publicado em http://200.18.99.113:8088 (NAT 8088 -> VM:8080).
# Só preencha VITE_API_URL se a API estiver em OUTRA origem (sem barra final):
#
# VITE_API_URL=http://200.18.99.113:8088
#
# VITE_WS_URL vazio = usa a mesma origem da API, trocando http por ws.
VITE_WS_URL=

# Limites de fotos (o backend valida de novo, com os mesmos valores).
VITE_MIN_PHOTOS=3
VITE_MAX_PHOTOS=10
VITE_MAX_PHOTO_MB=5
